{
  "name": "wisecho",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "author": "Heïdi Al Ihmid Jeremia (Innovat1k)",
  "description": "An interactive quote generator with theme preview, favorite management, and API integration, built to demonstrate React.js and modern frontend techniques.",
  "scripts": {
    "dev": "vite",
    "backend": "node server/index.js",
    "backend:dev": "nodemon server/index.js",
    "dev:all": "concurrently \"npm run backend:dev\" \"npm run dev\"",
    "build": "vite build",
    "lint": "eslint . --ext .js,.jsx",
    "lint:fix": "eslint . --ext .js,.jsx --fix",
    "preview": "vite preview",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "framer-motion": "^12.23.12",
    "jotai": "^2.13.1",
    "node-fetch": "^3.3.2",
    "npm-check-updates": "^18.0.3",
    "radix-ui": "^1.4.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.8.2",
    "tailwindcss": "^4.1.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "@vitest/ui": "^3.2.7",
    "c8": "^10.1.3",
    "concurrently": "^9.2.1",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "nodemon": "^3.1.10",
    "vite": "^7.1.4",
    "vitest": "^3.2.7"
  }
}
